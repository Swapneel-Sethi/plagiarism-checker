# 1. Copy this file to ".env"  (same folder as server.js)
# 2. Paste your real SerpAPI key after the = sign
# 3. Run:  node server.js
#
# Without a key the app still runs, but web search is best-effort (DuckDuckGo/Bing)
# and may be rate-limited or blocked. With a key, web scanning is reliable.
SERPAPI_KEY=your_serpapi_key_here
